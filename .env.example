# Backend configuration (copy to backend/.env)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ADMIN_APP_PATH=
PUBLIC_API_URL=http://localhost:4000
API_ORIGIN=
# Enable when serving the production storefront and admin bundles together.
SERVE_WEB=false
# Set only to the number of trusted reverse proxy hops used by your host.
TRUST_PROXY=0
COOKIE_DOMAIN=
# Production: absolute path on a persistent disk.
UPLOAD_DIR=./uploads
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP credentials belong only in backend/.env. Never expose them through VITE_* variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Use a sender authorized by your SMTP provider. Blank uses SMTP_USER.
SMTP_FROM=

# Optional services; these are server-side secrets, never VITE_* values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
